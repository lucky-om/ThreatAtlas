# ─── ThreatAtlas Frontend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# In Vercel, add these under Project Settings → Environment Variables.

# VirusTotal API Key (required for all scan features)
VITE_VT_API_KEY=your_virustotal_api_key_here

# Backend API Base URL
# LOCAL dev: Leave empty OR set to http://localhost:3001 (Vite proxy handles /api/* in dev)
# PRODUCTION (Vercel): Set to your Render backend URL, e.g. https://threatatlas-api.onrender.com
VITE_API_BASE_URL=http://localhost:3001
