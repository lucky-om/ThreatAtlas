# ─── ThreatAtlas Frontend Environment Variables ───────────────────────────────
# Copy this file to .env.local and fill in your values.
# In Vercel, add these under Project Settings → Environment Variables.

# VirusTotal API Key (required for all scan features)
VITE_VT_API_KEY=your_virustotal_api_key_here

# Backend API Base URL — points to your Render deployment
# For local development: http://localhost:3001
# For production: https://your-backend-name.onrender.com
VITE_API_BASE_URL=https://your-backend-name.onrender.com

# (Optional) Groq AI API Key — for AI Chatbot assistant
VITE_GROQ_API_KEY=your_groq_api_key_here
