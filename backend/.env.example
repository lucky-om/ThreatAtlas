# ─── ThreatAtlas Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# In Render, add these under Environment → Environment Variables.

# Server port (Render sets this automatically — do NOT override)
PORT=3001

# Allowed CORS origins (comma-separated, no trailing slash)
# Example: https://threatatlas.luckyverse.tech,https://threatatlas.vercel.app
ALLOWED_ORIGINS=https://threatatlas.luckyverse.tech,http://localhost:3002
