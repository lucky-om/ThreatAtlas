# ─── ThreatAtlas Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# In Render, add these under Environment → Environment Variables.

# Server port (Render sets this automatically — do NOT override it on Render)
PORT=3001

# VirusTotal API Key (required for all scan features)
VT_API_KEY=your_virustotal_api_key_here

# Groq AI API Key (required for Atlas AI chatbot)
ATLAS_API_KEY=your_groq_api_key_here

# Allowed CORS origins — no trailing slashes, comma-separated
# For Render: include your Vercel domain and custom domain
ALLOWED_ORIGINS=https://threatatlas.luckyverse.tech,https://threatatlas.vercel.app,http://localhost:3002
