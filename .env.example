# ThreatAtlas Environment Configuration
PORT=3000

# VirusTotal API v3 Key (Required for scanning & intelligence lookups)
VT_API_KEY=your_virustotal_api_key_here

# AI Copilot & Neural Summary Keys (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Redis Connection (Optional - defaults to localhost:6379, falls back to in-memory queue)
REDIS_HOST=localhost
REDIS_PORT=6379
